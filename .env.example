# Copy this file to ".env" and fill in real values. Never commit ".env".

# Generate a long random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Path of the SQLite file (created automatically)
DATABASE_PATH=instance/hostel.db

# Timezone used for attendance days and the curfew (IANA name)
TIMEZONE=Asia/Karachi

# Curfew time (24h HH:MM). Entries after this are marked Late.
CURFEW_TIME=22:00

# The attendance day starts at this local time (an arrival at 00:30 is late for the previous day)
ATTENDANCE_DAY_START=04:00

# Set to 1 only for local development
FLASK_DEBUG=0

# --- Email (optional: the app works without it; alerts are still saved and shown) ---
# Leave MAIL_SERVER empty until you have a real mail server. Gmail: smtp.gmail.com, port 587, TLS 1, an "app password".
# Check it afterwards in the app: Admin -> Email -> Send test.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=1
# Port 465 uses SSL automatically (MAIL_USE_SSL=1). App passwords may be pasted with their spaces.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Shown in alert and report emails
HOSTEL_NAME=Hostel Security System

# Weekly parent report (local time) and whether the background scheduler runs
WEEKLY_REPORT_DAY=sun
WEEKLY_REPORT_TIME=20:00
SCHEDULER_ENABLED=1

# Encrypts stored face templates. Create with:  flask --app run generate-biometric-key
# Keep it secret and back it up: without it, enrolled faces cannot be read.
BIOMETRIC_KEY=

# Local testing only: one-click demo logins on the login page. Leave 0 anywhere else.
DEV_QUICK_LOGIN=0

# --- Optional tuning (the defaults are fine for a demo) ---
# Machines allowed to open the entry terminal (comma separated). The terminal needs no login, so keep this to the gate computer.
TERMINAL_ADDRESSES=127.0.0.1,::1
# Set to 1 only when the site is served over HTTPS (with plain http://localhost it must stay 0)
SESSION_COOKIE_SECURE=0
# Security alert: this many failed attempts within this many minutes
ALERT_FAILED_THRESHOLD=3
ALERT_WINDOW_MINUTES=5
# Face match: smaller = stricter. Read docs/recognition-limits.md before changing.
FACE_THRESHOLD=0.5
# Enrollment duplicate check (same face enrolled twice). Smaller = fewer false 'already enrolled' errors.
DUPLICATE_FACE_THRESHOLD=0.4
# Eye-region fallback is experimental and OFF by default (see docs/recognition-limits.md)
EYE_FALLBACK_ENABLED=0
